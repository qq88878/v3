# 环境配置文件示例
# 复制此文件为 .env 并填入实际配置

# 应用环境 (development/staging/production)
APP_ENV=development

# 调试模式 (true/false)
DEBUG=true

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 服务器配置
HOST=0.0.0.0
PORT=8000

# API密钥 (如果需要)
API_KEY=

# 密钥 (用于加密等)
SECRET_KEY=your-secret-key-change-in-production

# 数据库配置
DATABASE_URL=sqlite:///./app.db

# Agent配置
MAX_MEMORY_SIZE=100

# 其他自定义配置
# CUSTOM_CONFIG=
